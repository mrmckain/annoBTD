# macOS
.DS_Store

# compiled ARAGORN; build it from third_party/aragorn (see README.txt there):
#   cc -O2 -w -o bin/aragorn third_party/aragorn/aragorn1.2.41.c -lm
bin/

# the reference database: sketch databases, taxonomy table and derived profile
# tables, 1.5 GB; filled by ./fetch_refdb.sh (published bundle) or rebuilt by
# test/refresh_references.sh --install
refdb/

# regression harness: the GenBank flat-file cache, result directories and the
# archive of superseded runs
test/gb_cache/
test/archive/
test/results*/
test/refresh.new/
